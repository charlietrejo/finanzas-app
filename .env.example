NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sección 3.8 (logos reales de bancos, rama feature/bank-logos): publishable
# key (empieza con pk_) de tu cuenta gratuita en https://www.logo.dev/signup
# — dashboard > API Keys. Es segura de exponer al cliente (NEXT_PUBLIC_), es
# justo el tipo de token que Logo.dev diseñó para usarse en <img> desde el
# navegador. Sin esta variable, el logo simplemente no se muestra (solo
# queda el nombre en texto).
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Fase 8 (motor de recurrencias): NUNCA con prefijo NEXT_PUBLIC_, son
# server-only. SUPABASE_SERVICE_ROLE_KEY viene del dashboard de Supabase
# (Settings > API > service_role) — bypassea RLS, no lo compartas ni lo
# subas a git. CRON_SECRET es un secreto que tú inventas (ej. una cadena
# aleatoria larga) para que /api/cron/generate-recurring no sea invocable
# públicamente; debe coincidir con el que configures en Vercel.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
