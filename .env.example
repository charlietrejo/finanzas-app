NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 8 (motor de recurrencias): NUNCA con prefijo NEXT_PUBLIC_, son
# server-only. SUPABASE_SERVICE_ROLE_KEY viene del dashboard de Supabase
# (Settings > API > service_role) — bypassea RLS, no lo compartas ni lo
# subas a git. CRON_SECRET es un secreto que tú inventas (ej. una cadena
# aleatoria larga) para que /api/cron/generate-recurring no sea invocable
# públicamente; debe coincidir con el que configures en Vercel.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
